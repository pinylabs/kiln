				"slug": "firing-14",
				"status": "published",
				"data": {
					"title": "Firing nº 14",
					"excerpt": "Thirty-two pieces out of the kiln: morning mugs, moss mugs, and bowls for rice, pasta and everything in between.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1609881583302-61548332039c?w=1600&q=80&fm=jpg&fit=max",
							"alt": "A potter throwing a pot on the wheel",
							"filename": "kiln-firing-14.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"_key": "k36",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k37",
									"text": "The kiln cooled overnight, and this morning we opened it on thirty-two pieces: pairs of morning mugs in speckled white, a run of moss mugs in the ash glaze, plain bowls in porcelain slip, and sets of rice and pasta bowls.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k38",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k39",
									"text": "From one wheel",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k40",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k41",
									"text": "Every piece in this firing was thrown, trimmed and glazed by hand on one wheel, then fired twice: once to bisque, once to glaze. The ash glaze moves the most in the second firing, so the moss mugs are the ones that surprise us.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k42",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k43",
									"text": "When it sells out",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k44",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k45",
									"text": "Each firing is small. When this one sells out, the next one opens to the list first.",
									"marks": []
								}
							]
						}
					]
				},
