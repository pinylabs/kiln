---
// The preview home, from its accepted design. The full template is being built by the Pinies;
// until then this page is the theme's home and the rest of the site is EmDash's own template.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kiln — stoneware made by hand</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400..600&display=swap">
<style is:global>
/* The motion every site shares. Only transform and opacity move, so it stays on the compositor at 60 fps. Under
   prefers-reduced-motion everything is still, and a browser without scroll timelines simply shows the page. */

/* Page changes: the browser's cross-document view transition, as Astro's view transitions give it. A picture that
   names itself the same on both pages grows into its place; the rest fades and slides. */
@view-transition { navigation: auto; }
::view-transition-old(root) { animation: 260ms cubic-bezier(.4, 0, 1, 1) both vt-out; }
::view-transition-new(root) { animation: 420ms cubic-bezier(0, 0, .2, 1) 80ms both vt-in; }
::view-transition-group(*) { animation-duration: 520ms; animation-timing-function: cubic-bezier(.2, .8, .2, 1); }
@keyframes vt-out { to { opacity: 0; transform: translateY(-12px); } }
@keyframes vt-in { from { opacity: 0; transform: translateY(24px); } }

/* The hero's first moment: its words rise one line after another. */
.rise { animation: rise .9s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i, 0) * 110ms + 120ms); }
@keyframes rise { from { opacity: 0; transform: translateY(36px); } }

/* Scroll-driven: reveals move with `translate` and `scale`, so a card's hover `transform` still applies.
   The hero's photo drifts slower than the page, and its words lift away. */
@supports (animation-timeline: scroll()) {
  .parallax { animation: parallax linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
  .lift { animation: lift linear both; animation-timeline: scroll(root); animation-range: 0 70vh; }
  .reveal { animation: reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
  .reveal-side { animation: reveal-side linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; }
  .zoom-in { animation: zoom-in linear both; animation-timeline: view(); animation-range: entry 0% cover 50%; }
}
@keyframes parallax { from { transform: translateY(0) scale(1.08); } to { transform: translateY(22%) scale(1.16); } }
@keyframes lift { to { opacity: 0; transform: translateY(-90px); } }
@keyframes reveal { from { opacity: 0; translate: 0 70px; scale: .97; } }
@keyframes reveal-side { from { opacity: 0; translate: -60px 0; } }
@keyframes zoom-in { from { transform: scale(1.25); } }

/* Hover, for a site that takes it: a card lifts and its photo leans in. Each site adds its own signature beside it. */
.lift-card { transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s; }
.lift-card .pic img { transition: transform .9s cubic-bezier(.2, .8, .2, 1); }
.lift-card:hover { transform: translateY(-8px); }
.lift-card:hover .pic img { transform: scale(1.07); }
.button { transition: transform .25s cubic-bezier(.2, .8, .2, 1), background-color .25s; }
.button:hover { transform: translateY(-2px); }

/* Calm: opacity only, for a site whose signature is stillness. */
@supports (animation-timeline: view()) {
  .fade { animation: fade linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
}
@keyframes fade { from { opacity: 0; } }

/* The Pinies' entrances, the public site's four, played once when their row comes into view. */
.pinies[data-entrance] .face { animation-duration: .9s; animation-fill-mode: both; animation-delay: calc(var(--i) * .14s); animation-timing-function: cubic-bezier(.3, .7, .3, 1); }
.pinies[data-entrance='walk'] .face { animation-name: walk; }
.pinies[data-entrance='skid'] .face { animation-name: skid; }
.pinies[data-entrance='drop'] .face { animation-name: drop; animation-timing-function: ease-in; }
.pinies[data-entrance='peek'] .face { animation-name: peek; }
.pinies[data-entrance='peek'] .face:last-child { animation-name: peek, wave; animation-duration: .9s, .6s; animation-delay: calc(4 * .14s), 1.5s; animation-fill-mode: both, none; }
.pinies:not([data-entrance]):not([data-shown]) .face { opacity: 0; }
@keyframes walk {
  0% { transform: translateX(-120px); opacity: 0; } 12% { opacity: 1; }
  20% { transform: translateX(-96px) translateY(-4px); } 35% { transform: translateX(-70px) translateY(0); }
  50% { transform: translateX(-44px) translateY(-4px); } 65% { transform: translateX(-16px) translateY(0); }
  80% { transform: translateX(0) translateY(-16px); } 100% { transform: translateX(0) translateY(0); }
}
@keyframes skid {
  0% { transform: translateX(520px) rotate(0); opacity: 0; } 15% { opacity: 1; }
  65% { transform: translateX(-8px) rotate(-12deg); } 82% { transform: translateX(3px) rotate(3deg); } 100% { transform: translateX(0) rotate(0); }
}
@keyframes drop {
  0% { transform: translateY(-120px); opacity: 0; } 15% { opacity: 1; }
  60% { transform: translateY(0); } 75% { transform: translateY(-12px); } 90% { transform: translateY(0); } 95% { transform: translateY(-3px); } 100% { transform: translateY(0); }
}
@keyframes peek { 0% { transform: translateY(56px); opacity: 0; } 20% { opacity: 1; } 70% { transform: translateY(-5px); } 100% { transform: translateY(0); } }
@keyframes wave { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-12deg); } 50% { transform: rotate(10deg); } 75% { transform: rotate(-6deg); } }

/* Still: reduced motion, and the stills this mock renders. */
@media (prefers-reduced-motion: reduce) {
  @view-transition { navigation: none; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .pinies .face { opacity: 1 !important; }
}
html.still *, html.still *::before, html.still *::after { animation: none !important; transition: none !important; }
html.still .pinies .face { opacity: 1 !important; }
</style>
<style is:global>
:root {
  --bone: #f4eee5; --ink: #2a211c; --soft: #74665b; --clay: #b5553a; --sage: #8a9a7b; --card: #fbf7f1; --line: #e3d8c8;
  --serif: 'Instrument Serif', Georgia, serif; --sans: 'Inter', system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) { :root { --bone: #1c1714; --ink: #f1e8dc; --soft: #b3a497; --clay: #e07a5c; --card: #241d19; --line: #3a3029; } }
* { box-sizing: border-box; margin: 0; }
html { background: var(--bone); }
body { background: var(--bone); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; overflow-x: clip; }
a { color: inherit; text-decoration: none; }
.wrap { max-width: 1240px; margin: 0 auto; padding: 0 40px; }
header .wrap { display: flex; align-items: center; justify-content: space-between; height: 84px; }
.mark { font-family: var(--serif); font-size: 34px; font-style: italic; letter-spacing: -.01em; }
nav { display: flex; gap: 28px; font-size: 14px; color: var(--soft); align-items: center; }
nav .bag { color: var(--ink); border-bottom: 1px solid var(--ink); }
.hero { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; padding: 20px 0 80px; }
.hero h1 { font-family: var(--serif); font-weight: 400; font-size: 112px; line-height: .92; letter-spacing: -.02em; }
.hero h1 em { color: var(--clay); }
.hero p { font-size: 18px; line-height: 1.6; color: var(--soft); max-width: 420px; margin: 24px 0 30px; }
.hero .cta { display: inline-flex; gap: 10px; align-items: center; background: var(--ink); color: var(--bone); padding: 15px 24px; border-radius: 999px; font-size: 15px; font-weight: 500; }
/* The signature: an arch of clay-coloured light that the pieces cross through, slowly, one after another. */
.arch { position: relative; aspect-ratio: 4 / 5; border-radius: 999px 999px 24px 24px; overflow: hidden; background: #e9dccb; }
.arch img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: cross 18s ease-in-out infinite; }
.arch img:nth-child(1) { animation-delay: 0s; } .arch img:nth-child(2) { animation-delay: 6s; } .arch img:nth-child(3) { animation-delay: 12s; }
@keyframes cross { 0% { opacity: 0; transform: scale(1.06); } 8%, 33% { opacity: 1; } 41%, 100% { opacity: 0; transform: scale(1); } }
html.still .arch img:first-child { opacity: 1; animation: none; }
@media (prefers-reduced-motion: reduce) { .arch img { animation: none; } .arch img:first-child { opacity: 1; } }
.arch .tag { position: absolute; left: 22px; bottom: 22px; background: var(--card); padding: 10px 14px; border-radius: 999px; font-size: 13px; }
.pieces { padding: 24px 0 88px; }
.pieces .head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 30px; }
.pieces h2 { font-family: var(--serif); font-weight: 400; font-size: 64px; letter-spacing: -.02em; }
.pieces .head p { color: var(--soft); font-size: 15px; }
.grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; perspective: 900px; }
.piece { grid-column: span 4; transform-style: preserve-3d; transition: transform .5s cubic-bezier(.2, .8, .2, 1); transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); }
.piece.tall { grid-column: span 5; } .piece.wide { grid-column: span 7; }
.piece .pic { border-radius: 18px; overflow: hidden; background: var(--card); aspect-ratio: 4 / 5; box-shadow: 0 30px 50px -38px rgba(42, 33, 28, .6); }
.piece.wide .pic { aspect-ratio: 7 / 5; }
.piece .pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
.piece .row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 14px; }
.piece h3 { font-family: var(--serif); font-weight: 400; font-size: 28px; }
.piece .buy { font-size: 14px; border: 1px solid var(--ink); border-radius: 999px; padding: 8px 14px; transition: background .2s, color .2s; }
.piece:hover .buy { background: var(--ink); color: var(--bone); }
.piece small { display: block; color: var(--soft); font-size: 13px; margin-top: 2px; }
.studio { background: var(--clay); color: #fff7ef; }
.studio .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; padding: 0 40px; }
.studio .pic { height: 560px; overflow: hidden; }
.studio .pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
.studio h2 { font-family: var(--serif); font-weight: 400; font-size: 60px; line-height: 1; }
.studio p { font-size: 17px; line-height: 1.65; margin-top: 18px; max-width: 460px; opacity: .92; }
.stripe { padding: 56px 0; text-align: center; color: var(--soft); font-size: 14px; }
.stripe b { color: var(--ink); font-weight: 600; }
footer { border-top: 1px solid var(--line); padding: 40px 0 48px; }
footer .wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: end; }
footer .made { display: flex; align-items: flex-end; gap: 18px; }
.pinies { display: flex; }
.pinies .face { width: 54px; height: 54px; margin-right: -8px; }
.pinies .face svg { width: 100%; height: 100%; }
footer .made p { font-size: 14px; line-height: 1.6; color: var(--soft); }
footer .made a { color: var(--ink); text-decoration: underline; }
footer .credits { font-size: 12px; line-height: 1.8; color: var(--soft); }
footer .credits a { text-decoration: underline; text-decoration-color: var(--line); }
@media (max-width: 767px) {
  .wrap { padding: 0 18px; }
  nav a:not(.bag) { display: none; }
  .hero { grid-template-columns: 1fr; gap: 28px; padding: 8px 0 48px; }
  .hero h1 { font-size: 64px; }
  .arch { order: -1; aspect-ratio: 1 / 1; }
  .pieces h2 { font-size: 42px; }
  .pieces .head { flex-direction: column; align-items: start; gap: 6px; }
  .grid { grid-template-columns: 1fr; }
  .piece, .piece.tall, .piece.wide { grid-column: auto; }
  .studio .wrap { grid-template-columns: 1fr; padding: 0 0 40px; gap: 24px; }
  .studio .wrap > div:last-child { padding: 0 18px; }
  .studio .pic { height: 340px; }
  .studio h2 { font-size: 40px; }
  footer .wrap { grid-template-columns: 1fr; }
  footer .made { flex-direction: column; align-items: flex-start; }
}
.still-card { height: 100%; display: grid; place-items: center; background: linear-gradient(135deg, var(--sky1, #bfe8ef), var(--sky2, #ffe2b8)); font-family: var(--display); font-weight: 700; font-size: 34px; color: var(--ink); }
</style>
</head>
<body>
<header><div class="wrap">
  <a class="mark" href="/">Kiln</a>
  <nav><a href="#">Pieces</a><a href="#">The studio</a><a href="#">Care</a><a class="bag" href="#">Bag (1)</a></nav>
</div></header>
<main class="wrap">
  <section class="hero">
    <div>
      <h1 class="rise" style="--i:0">Made by hand, <em>fired twice.</em></h1>
      <p class="rise" style="--i:1">Small batches of stoneware from one studio: mugs, bowls and plates for every day. Each piece is a little different, and the checkout is Stripe's own.</p>
      <a class="cta rise" style="--i:2" href="/products">See this firing →</a>
    </div>
    <div class="arch"><img src="https://images.unsplash.com/photo-1495100497150-fe209c585f50?w=1600&q=75&auto=format&fit=crop" alt="A grey stoneware mug on a wooden table"><img src="https://images.unsplash.com/photo-1530006498959-b7884e829a04?w=1600&q=75&auto=format&fit=crop" alt="Two speckled bowls"><img src="https://images.unsplash.com/photo-1525973779373-015bdf68e579?w=1600&q=75&auto=format&fit=crop" alt="Four white bowls on white"><span class="tag">Firing nº 14 · 32 pieces</span></div>
  </section>
  <section class="pieces">
    <div class="head"><h2 class="reveal">This firing</h2><p class="reveal">Prices in AUD. Paid on Stripe's checkout page.</p></div>
    <div class="grid">
      <a class="piece tall reveal" href="/products"><div class="pic"><img style="view-transition-name: piece-cups" src="https://images.unsplash.com/photo-1536936812504-0e77dc3f0b40?w=1200&q=75&auto=format&fit=crop" alt="Two white stoneware mugs" loading="lazy"></div><div class="row"><div><h3>Morning mug, pair</h3><small>Speckled white · 350 ml</small></div><span class="buy">$68</span></div></a>
      <a class="piece wide reveal" href="#"><div class="pic"><img src="https://images.unsplash.com/photo-1530006498959-b7884e829a04?w=1600&q=75&auto=format&fit=crop" alt="Two speckled bowls" loading="lazy"></div><div class="row"><div><h3>Rice bowls</h3><small>Set of two</small></div><span class="buy">$54</span></div></a>
      <a class="piece reveal" href="#"><div class="pic"><img src="https://images.unsplash.com/photo-1761830476467-0ff86dbcc75d?w=900&q=75&auto=format&fit=crop" alt="A plain white bowl" loading="lazy"></div><div class="row"><div><h3>Plain bowl</h3><small>Porcelain slip</small></div><span class="buy">$32</span></div></a>
      <a class="piece reveal" href="#"><div class="pic"><img src="https://images.unsplash.com/photo-1517430536-ef20313aea20?w=900&q=75&auto=format&fit=crop" alt="A green mug held in two hands" loading="lazy"></div><div class="row"><div><h3>Moss mug</h3><small>Ash glaze</small></div><span class="buy">$38</span></div></a>
      <a class="piece reveal" href="#"><div class="pic"><img src="https://images.unsplash.com/photo-1525973779373-015bdf68e579?w=900&q=75&auto=format&fit=crop" alt="Four white bowls" loading="lazy"></div><div class="row"><div><h3>Pasta bowls</h3><small>Set of four</small></div><span class="buy">$110</span></div></a>
    </div>
  </section>
</main>
<section class="studio"><div class="wrap"><div class="pic"><img class="zoom-in" src="https://images.unsplash.com/photo-1609881583302-61548332039c?w=1600&q=75&auto=format&fit=crop" alt="A potter throwing a pot on the wheel" loading="lazy"></div><div class="reveal"><h2>From one wheel, in small firings</h2><p>Every piece is thrown, trimmed and glazed by hand, then fired twice. When a firing sells out, the next one opens to the list.</p></div></div></section>
<div class="stripe"><b>Checkout by Stripe.</b> Cards and wallets are taken on Stripe's own page; this site never sees them.</div>
<footer><div class="wrap">
