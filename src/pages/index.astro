---
// The preview home, from its accepted design. The full template is being built by the Pinies;
// until then this page is the theme's home and the rest of the site is EmDash's own template.
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kiln — stoneware made by hand</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400..600&display=swap">
</head>
<body>
<header><div class="wrap flex h-header items-center justify-between">
  <a class="font-serif text-title-md italic" href="/">Kiln</a>
  <nav class="flex items-center gap-7 text-label text-neutral-600 dark:text-neutral-400"><a class="max-md:hidden" href="/products">Pieces</a><a class="max-md:hidden" href="/about">The studio</a><a class="max-md:hidden" href="/care">Care</a><a class="border-b border-current text-neutral-800 dark:text-neutral-200" href="#">Bag (1)</a></nav>
</div></header>
<main class="wrap">
  <section class="grid grid-cols-2 items-center gap-14 pt-5 pb-20 max-md:grid-cols-1 max-md:gap-7 max-md:pt-2 max-md:pb-12">
    <div>
      <h1 class="rise font-serif text-display-3xl leading-hero max-md:text-display-xl" style="--i:0">Made by hand, <em class="text-primary-600 dark:text-primary-400">fired twice.</em></h1>
      <p class="rise mt-6 mb-7.5 max-w-measure text-intro text-neutral-600 dark:text-neutral-400" style="--i:1">Small batches of stoneware from one studio: mugs, bowls and plates for every day. Each piece is a little different, and the checkout is Stripe's own.</p>
      <a class="cta rise" style="--i:2" href="/products">See this firing →</a>
    </div>
    <div class="arch aspect-4/5 max-md:-order-1 max-md:aspect-square"><img src="https://images.unsplash.com/photo-1495100497150-fe209c585f50?w=1600&q=75&auto=format&fit=crop" alt="A grey stoneware mug on a wooden table"><img src="https://images.unsplash.com/photo-1530006498959-b7884e829a04?w=1600&q=75&auto=format&fit=crop" alt="Two speckled bowls"><img src="https://images.unsplash.com/photo-1525973779373-015bdf68e579?w=1600&q=75&auto=format&fit=crop" alt="Four white bowls on white"><span class="absolute bottom-5.5 left-5.5 rounded-pill bg-neutral-50 px-3.5 py-2.5 text-caption dark:bg-neutral-900">Firing nº 14 · 32 pieces</span></div>
  </section>
  <section class="pt-6 pb-22">
    <div class="mb-7.5 flex items-end justify-between max-md:flex-col max-md:items-start max-md:gap-1.5"><h2 class="reveal font-serif text-display-xl leading-normal max-md:text-display-xs">This firing</h2><p class="reveal text-button text-neutral-600 dark:text-neutral-400">Prices in AUD. Paid on Stripe's checkout page.</p></div>
    <div class="grid grid-cols-12 gap-6 perspective-tilt max-md:grid-cols-1">
      <a class="piece reveal col-span-5 max-md:col-auto" href="/products/morning-mug-pair"><div class="pic"><img style="view-transition-name: piece-cups" src="https://images.unsplash.com/photo-1536936812504-0e77dc3f0b40?w=1200&q=75&auto=format&fit=crop" alt="Two white stoneware mugs" loading="lazy"></div><div class="mt-3.5 flex items-baseline justify-between"><div><h3 class="font-serif text-title-sm">Morning mug, pair</h3><small class="mt-0.5 block text-caption text-neutral-600 dark:text-neutral-400">Speckled white · 350 ml</small></div><span class="buy">$68</span></div></a>
      <a class="piece reveal col-span-7 max-md:col-auto" href="/products/rice-bowls"><div class="pic aspect-7/5"><img src="https://images.unsplash.com/photo-1530006498959-b7884e829a04?w=1600&q=75&auto=format&fit=crop" alt="Two speckled bowls" loading="lazy"></div><div class="mt-3.5 flex items-baseline justify-between"><div><h3 class="font-serif text-title-sm">Rice bowls</h3><small class="mt-0.5 block text-caption text-neutral-600 dark:text-neutral-400">Set of two</small></div><span class="buy">$54</span></div></a>
      <a class="piece reveal col-span-4 max-md:col-auto" href="/products/plain-bowl"><div class="pic"><img src="https://images.unsplash.com/photo-1761830476467-0ff86dbcc75d?w=900&q=75&auto=format&fit=crop" alt="A plain white bowl" loading="lazy"></div><div class="mt-3.5 flex items-baseline justify-between"><div><h3 class="font-serif text-title-sm">Plain bowl</h3><small class="mt-0.5 block text-caption text-neutral-600 dark:text-neutral-400">Porcelain slip</small></div><span class="buy">$32</span></div></a>
      <a class="piece reveal col-span-4 max-md:col-auto" href="/products/moss-mug"><div class="pic"><img src="https://images.unsplash.com/photo-1517430536-ef20313aea20?w=900&q=75&auto=format&fit=crop" alt="A green mug held in two hands" loading="lazy"></div><div class="mt-3.5 flex items-baseline justify-between"><div><h3 class="font-serif text-title-sm">Moss mug</h3><small class="mt-0.5 block text-caption text-neutral-600 dark:text-neutral-400">Ash glaze</small></div><span class="buy">$38</span></div></a>
      <a class="piece reveal col-span-4 max-md:col-auto" href="/products/pasta-bowls"><div class="pic"><img src="https://images.unsplash.com/photo-1525973779373-015bdf68e579?w=900&q=75&auto=format&fit=crop" alt="Four white bowls" loading="lazy"></div><div class="mt-3.5 flex items-baseline justify-between"><div><h3 class="font-serif text-title-sm">Pasta bowls</h3><small class="mt-0.5 block text-caption text-neutral-600 dark:text-neutral-400">Set of four</small></div><span class="buy">$110</span></div></a>
    </div>
  </section>
</main>
<section class="bg-primary-600 text-primary-50 dark:bg-primary-400"><div class="wrap grid grid-cols-2 items-center gap-14 max-md:grid-cols-1 max-md:gap-6 max-md:px-0 max-md:pb-10"><div class="h-studio overflow-hidden max-md:h-studio-sm"><img class="zoom-in block size-full object-cover" src="https://images.unsplash.com/photo-1609881583302-61548332039c?w=1600&q=75&auto=format&fit=crop" alt="A potter throwing a pot on the wheel" loading="lazy"></div><div class="reveal max-md:px-4.5"><h2 class="font-serif text-display-lg leading-none tracking-normal max-md:text-title-xl">From one wheel, in small firings</h2><p class="mt-4.5 max-w-lede text-lede opacity-92">Every piece is thrown, trimmed and glazed by hand, then fired twice. When a firing sells out, the next one opens to the list.</p></div></div></section>
<div class="py-14 text-center text-label text-neutral-600 dark:text-neutral-400"><b class="font-semibold text-neutral-800 dark:text-neutral-200">Checkout by Stripe.</b> Cards and wallets are taken on Stripe's own page; this site never sees them.</div>
<SiteFooter />
<script is:inline>
// The pieces tilt toward the pointer, a few degrees, and settle back when it leaves.
(() => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(hover: none)').matches) return;
  for (const piece of document.querySelectorAll('.piece')) {
    piece.addEventListener('pointermove', event => {
      const box = piece.getBoundingClientRect();
      piece.style.setProperty('--ry', ((event.clientX - box.left) / box.width - .5) * 10 + 'deg');
      piece.style.setProperty('--rx', ((event.clientY - box.top) / box.height - .5) * -8 + 'deg');
    });
    piece.addEventListener('pointerleave', () => { piece.style.removeProperty('--rx'); piece.style.removeProperty('--ry'); });
  }
})();
</script>
<script is:inline>
// The Pinies' entrance: when a row of them comes into view, they play the next of the public site's four, in order,
// remembered in this browser, never random. Reduced motion, no storage or no script: the Pinies simply stand there.
(() => {
  const order = ['walk', 'skid', 'drop', 'peek'];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('still');
  for (const row of document.querySelectorAll('.pinies')) {
    row.querySelectorAll('.face').forEach((face, i) => face.style.setProperty('--i', String(i)));
    if (still || !('IntersectionObserver' in window)) { row.dataset.shown = ''; continue; }
    const seen = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      seen.disconnect();
      let next = 0;
      try { next = (Number(localStorage.getItem('tm06-entrance-next')) || 0) % order.length; localStorage.setItem('tm06-entrance-next', String(next + 1)); } catch {}
      row.dataset.entrance = row.dataset.play || order[next];
      setTimeout(() => { row.dataset.shown = ''; delete row.dataset.entrance; }, 2600);
    }, { threshold: 0.6 });
    seen.observe(row);
  }
})();

// A hero's loop: the poster shows first; the clip loads and plays only with motion allowed and the page visible.
(() => {
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('still');
  for (const video of document.querySelectorAll('video[data-src]')) {
    if (still) continue;
    video.src = video.dataset.src;
    video.play().catch(() => {});
  }
})();
</script>
</body>
</html>
