---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="mx-auto max-w-article">
		<header class="mt-6 mb-10 text-center">
			<div class="mb-4.5 flex flex-wrap items-center justify-center gap-3.5 text-label text-neutral-600 dark:text-neutral-400">
				{
					post.data.publishedAt && (
						<time datetime={post.data.publishedAt.toISOString()}>
							{post.data.publishedAt.toLocaleDateString("en-US", {
								year: "numeric",
								month: "long",
								day: "numeric",
							})}
						</time>
					)
				}
				{
					categories.length > 0 && (
						<div class="chips">
							{categories.map((c) => (
								<a href={`/category/${c.slug}`}>{c.label}</a>
							))}
						</div>
					)
				}
			</div>
			<h1 class="rise font-serif text-display-2xl max-md:text-display-md" {...post.edit.title}>{post.data.title}</h1>
		</header>

		{
			post.data.featured_image && (
				<div class="pic -mx-15 mb-12 aspect-16/10 rounded-frame max-lg:mx-0" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} priority />
				</div>
			)
		}

		<div class="prose">
			<PortableText value={post.data.content} />
		</div>

		{
			tags.length > 0 && (
				<div class="chips mt-10 border-t border-neutral-300 pt-7 dark:border-neutral-700">
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`}>{t.label}</a>
					))}
				</div>
			)
		}
	</article>

	<aside class="mt-22 border-t border-neutral-300 pt-12 dark:border-neutral-700">
		<WidgetArea name="sidebar" class="grid grid-cols-widgets gap-6" />
	</aside>
</Base>
