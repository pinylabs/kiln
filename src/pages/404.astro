---
import Base from "../layouts/Base.astro";
---

<Base title="Not Found">
	<section class="pt-18 pb-10 text-center">
		<h1 class="rise font-serif text-display-3xl leading-hero max-md:text-display-xl">Page not <em class="text-primary-600 dark:text-primary-400">found.</em></h1>
		<p class="rise mx-auto mt-6 mb-7.5 max-w-measure text-intro text-neutral-600 dark:text-neutral-400" style="--i:1">The page you're looking for doesn't exist.</p>
		<a class="cta button rise" style="--i:2" href="/">Go home →</a>
	</section>
</Base>
