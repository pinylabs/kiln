---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: products,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("products", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across every post, instead of calling
// getEntryTerms() per post (which would be N round-trips).
const tagsByEntry = await getTermsForEntries(
	"products",
	products.map((p) => p.data.id),
	"tag",
);
const productsWithTags = products.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title="Pieces">
	<header class="page-head">
		<h1 class="rise page-title">This firing</h1>
		<p class="rise max-w-measure text-button text-neutral-600 dark:text-neutral-400" style="--i:1">Prices in AUD. Paid on Stripe's checkout page.</p>
	</header>

	{
		productsWithTags.length === 0 ? (
			<p class="py-10 text-body text-neutral-600 dark:text-neutral-400">No pieces yet. The next firing opens soon.</p>
		) : (
			<ul class="grid grid-cols-3 gap-x-6 gap-y-10 perspective-tilt max-lg:grid-cols-2 max-md:grid-cols-1">
				{productsWithTags.map(({ post, tags }) => (
					<li class="piece reveal hover-zoom">
						<a class="block" href={`/products/${post.id}`}>
							<div class="pic" {...post.edit.featured_image}>
								{post.data.featured_image && <Image image={post.data.featured_image} />}
							</div>
							<div class="mt-3.5 flex items-baseline justify-between gap-3">
								<div>
									<h2 class="font-serif text-title-sm leading-heading" {...post.edit.title}>{post.data.title}</h2>
									{post.data.excerpt && <small class="mt-0.5 block text-caption text-neutral-600 dark:text-neutral-400" {...post.edit.excerpt}>{post.data.excerpt}</small>}
								</div>
								{post.data.price && <span class="buy" {...post.edit.price}>{post.data.price}</span>}
							</div>
						</a>
						{tags.length > 0 && (
							<div class="chips mt-3">
								{tags.map((t) => (
									<a href={`/tag/${t.slug}`}>{t.label}</a>
								))}
							</div>
						)}
					</li>
				))}
			</ul>
		)
	}
	{
		(cursor || nextCursor) && (
			<nav class="pager" aria-label="Pagination">
				{cursor && <a href="/products">First page</a>}
				{nextCursor && (
					<a href={`/products?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>
				)}
			</nav>
		)
	}
</Base>
