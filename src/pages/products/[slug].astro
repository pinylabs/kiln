---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("products", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "products", id: post.data.id, slug }}
>
	<article class="grid grid-cols-product items-start gap-16 max-lg:grid-cols-1 max-lg:gap-7">
		<div class="pic sticky top-6 rounded-t-pill rounded-b-frame max-lg:static max-lg:aspect-square max-lg:max-w-photo" {...post.edit.featured_image}>
			{post.data.featured_image && <Image image={post.data.featured_image} priority />}
		</div>

		<div class="pt-6">
			{
				categories.length > 0 && (
					<div class="chips mt-7">
						{categories.map((c) => (
							<a href={`/category/${c.slug}`}>{c.label}</a>
						))}
					</div>
				)
			}

			<h1 class="rise mt-3.5 font-serif text-display-2xl max-md:text-display-md" {...post.edit.title}>{post.data.title}</h1>

			{post.data.excerpt && <p class="mt-4 text-intro text-neutral-600 dark:text-neutral-400" {...post.edit.excerpt}>{post.data.excerpt}</p>}

			<div class="mt-7.5 mb-2.5 flex flex-wrap items-center gap-5">
				{post.data.price && <span class="font-serif text-display-sm tracking-normal max-md:text-title-lg" {...post.edit.price}>{post.data.price}</span>}
				{
					post.data.payment_link && (
						<a class="cta button" href={post.data.payment_link} {...post.edit.payment_link}>
							Buy this piece →
						</a>
					)
				}
			</div>
			<p class="text-caption text-neutral-600 dark:text-neutral-400">Prices in AUD. Paid on Stripe's checkout page; this site never sees your card.</p>

			{
				post.data.content && (
					<div class="prose mt-9 border-t border-neutral-300 pt-8 dark:border-neutral-700">
						<PortableText value={post.data.content} />
					</div>
				)
			}

			{
				tags.length > 0 && (
					<div class="chips mt-7">
						{tags.map((t) => (
							<a href={`/tag/${t.slug}`}>{t.label}</a>
						))}
					</div>
				)
			}
		</div>
	</article>

	<aside class="mt-22 border-t border-neutral-300 pt-12 dark:border-neutral-700">
		<WidgetArea name="sidebar" class="grid grid-cols-widgets gap-6" />
	</aside>
</Base>
