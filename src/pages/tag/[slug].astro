---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
// The pieces in this term, shown once, on the first page; the cursor pages through the notes.
const products = cursor
	? null
	: await getEmDashCollection("products", {
			where: { tag: term.slug },
			orderBy: { published_at: "desc" },
			limit: 50,
		});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
	if (products) Astro.cache.set(products.cacheHint);
}
const pieces = products?.entries ?? [];
---

<Base title={`${term.label} — pieces and notes`} description={`Pieces and notes in ${term.label}`}>
	<header class="page-head">
		<div>
			<span class="mb-2.5 block text-caption tracking-eyebrow uppercase text-neutral-600 dark:text-neutral-400">Glaze</span>
			<h1 class="rise page-title">{term.label}</h1>
		</div>
	</header>

	{
		pieces.length === 0 && posts.length === 0 && (
			<p class="py-10 text-body text-neutral-600 dark:text-neutral-400">Nothing in this glaze yet.</p>
		)
	}

	{
		pieces.length > 0 && (
			<>
				<h2 class="section-title">Pieces</h2>
				<ul class="grid grid-cols-3 gap-x-6 gap-y-10 perspective-tilt max-lg:grid-cols-2 max-md:grid-cols-1">
					{pieces.map((piece) => (
						<li class="piece reveal hover-zoom">
							<a class="block" href={`/products/${piece.id}`}>
								<div class="pic" {...piece.edit.featured_image}>
									{piece.data.featured_image && <Image image={piece.data.featured_image} />}
								</div>
								<div class="mt-3.5 flex items-baseline justify-between gap-3">
									<div>
										<h3 class="font-serif text-title-sm leading-heading" {...piece.edit.title}>{piece.data.title}</h3>
										{piece.data.excerpt && <small class="mt-0.5 block text-caption text-neutral-600 dark:text-neutral-400" {...piece.edit.excerpt}>{piece.data.excerpt}</small>}
									</div>
									{piece.data.price && <span class="buy" {...piece.edit.price}>{piece.data.price}</span>}
								</div>
							</a>
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		posts.length > 0 && (
			<>
				<h2 class="section-title">Notes</h2>
				<ul class="grid gap-12">
					{posts.map((post) => (
						<li class="reveal hover-zoom">
							<a class="grid grid-cols-note items-center gap-10 max-md:grid-cols-1 max-md:gap-4.5" href={`/posts/${post.id}`}>
								<div class="pic aspect-4/3" {...post.edit.featured_image}>
									{post.data.featured_image && <Image image={post.data.featured_image} />}
								</div>
								<div>
									<h3 class="mt-2 mb-3.5 font-serif text-display-sm leading-none max-md:text-title-md" {...post.edit.title}>{post.data.title}</h3>
									{post.data.excerpt && <p class="max-w-excerpt text-body leading-story text-neutral-600 dark:text-neutral-400" {...post.edit.excerpt}>{post.data.excerpt}</p>}
								</div>
							</a>
						</li>
					))}
				</ul>
			</>
		)
	}
	{
		(cursor || nextCursor) && (
			<nav class="pager" aria-label="Pagination">
				{cursor && <a href={`/tag/${term.slug}`}>First page</a>}
				{nextCursor && (
					<a href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>
				)}
			</nav>
		)
	}
</Base>
